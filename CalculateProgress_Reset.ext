void CalculateProgress_Reset(const char* progHighWaterTag) {
    /* Reset the per-machine monotonic floor so the next job's percentage starts
       from zero.  The high-water mark is stored in a WinCC tag so that multiple
       machines using the same action module remain independent. */
    if (progHighWaterTag && progHighWaterTag[0] != '\0') {
        SetTagDouble(progHighWaterTag, 0.0);
    }
}
